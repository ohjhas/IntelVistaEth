[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
CatalogFile = e1000ev.cat
DriverVer   = 10/10/2026,1.0.0.0

[Manufacturer]
%Intel% = Intel, NTamd64

[ControlFlags]
ExcludeFromSelect = *

[Intel.NTamd64]
; - I217 / I218
%E153A.DeviceDesc% = E1000ev.ndi, PCI\VEN_8086&DEV_153A
%E153B.DeviceDesc% = E1000ev.ndi, PCI\VEN_8086&DEV_153B
%E155A.DeviceDesc% = E1000ev.ndi, PCI\VEN_8086&DEV_155A
